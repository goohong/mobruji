# ===========================================
# mobruji — 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값으로 채운다.
# .env는 .gitignore에 의해 커밋 금지.
# ===========================================

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=local

# ---- Backend ports ----
SERVER_PORT=8080
MANAGEMENT_PORT=8081

# ---- Local MySQL (docker-compose) ----
MYSQL_ROOT_PASSWORD=mobruji
MYSQL_DATABASE=mobruji
MYSQL_USER=mobruji
MYSQL_PASSWORD=mobruji

# ---- Web (Next.js) ----
# 클라이언트 노출 변수는 NEXT_PUBLIC_ 접두사 필수
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
