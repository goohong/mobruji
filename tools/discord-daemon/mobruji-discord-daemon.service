[Unit]
Description=mobruji Discord bot daemon
After=network-online.target
Wants=network-online.target
# 무한 재시작 루프 방어 — 5분(300s) 안에 5회 재시작 실패 시 unit 을 stop 한다.
# rev 15 #225: systemd 디폴트는 10s/5 로 RestartSec=10 과 결합 시 윈도우가 짧아
# 일시적 네트워크/디스코드 장애에도 빠르게 dead 상태로 빠질 수 있어 윈도우를 늘렸다.
# 참고: StartLimitIntervalSec/StartLimitBurst 는 [Unit] 섹션에 둔다 (systemd 229+).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# #909 F-2: NCP 실 운영 계정은 `mobruji`. 기존 `ubuntu` 는 bridge.service
# (`User=mobruji`) 와 비대칭이라 두 unit 이 같은 계정 권한으로 동작하도록 통일.
# 다른 계정 운영 환경은 `systemctl edit mobruji-discord-daemon` drop-in 으로 override.
User=mobruji
WorkingDirectory=/home/mobruji/mobruji/tools/discord-daemon
EnvironmentFile=/home/mobruji/mobruji/tools/discord-daemon/.env
ExecStart=/home/mobruji/mobruji/tools/discord-daemon/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/mobruji-discord-daemon.out.log
StandardError=append:/var/log/mobruji-discord-daemon.err.log

[Install]
WantedBy=multi-user.target
