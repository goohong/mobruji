# Discord 봇 토큰 (Developer Portal → Bot → Reset Token).
# Bot 권한: Message Content Intent 활성화 필수.
DISCORD_BOT_TOKEN=

# 명령을 받아들일 Discord user id (CSV). 정수 비교.
# 본인 user id 만 두는 것을 권장.
ALLOWED_USER_IDS=1295274270498226208

# mobruji 메인 채널 id. 다른 채널에서 온 메시지는 모두 무시됩니다.
# helper 응답도 기본적으로 이 채널로 push (DIGEST_CHANNEL_ID 미설정 시 fallback).
MOBRUJI_CHANNEL_ID=1506925497651560458

# digest 채널 id (옵션) — cycle digest push 대상.
# 미설정 시 MOBRUJI_CHANNEL_ID 로 fallback. 채널 분리하려면 digest 별 채널 id 입력.
# (#1019: 기존 NOTIFY_CHANNEL_ID 는 deprecated — DIGEST_CHANNEL_ID 로 rename. 기존
#  이름도 backward-compat 으로 인식하되 deprecation warning 1회 emit.)
DIGEST_CHANNEL_ID=

# alert 채널 id (옵션, #1020) — cycle idle / future-ts ERROR / escalation 등
# "알림" 류 push 의 1차 채널. fallback 순서:
#   ALERT_CHANNEL_ID → DIGEST_CHANNEL_ID → MOBRUJI_CHANNEL_ID.
# cycle digest 본체는 DIGEST_CHANNEL_ID 그대로. 사용자 응답 (helper bare body /
# auto-ack) 은 MOBRUJI_CHANNEL_ID 그대로.
# 1506927237809836113
ALERT_CHANNEL_ID=

# --- Claude API usage tracker (#1020) ---
# `~/.claude/projects/<project>/*.jsonl` assistant 메시지 `message.usage` 합산.
# 10% 단위 임계 도달 시 ALERT_CHANNEL_ID 로 push. 같은 % 두 번 push 금지.
# 단위: tokens (input + output + cache_creation + cache_read 합산).
# default: daily 1M, weekly 7M. 사용자 plan 갱신 시 조정.
# CLAUDE_DAILY_TOKEN_LIMIT=1000000
# CLAUDE_WEEKLY_TOKEN_LIMIT=7000000

# tracker loop 주기 (초). 기본 300 (5분). 양수 정수만 허용.
# CLAUDE_USAGE_INTERVAL_SECONDS=300

# tracker 가 스캔할 jsonl 디렉토리 (기본 ~/.claude/projects 전체).
# CLAUDE_USAGE_PROJECTS_ROOT=~/.claude/projects

# tracker state 파일 경로. atomic write.
# CLAUDE_USAGE_STATE_PATH=~/.mobruji/claude-usage.json

# --- helper tmux 세션 routing ---
# Discord 사용자 메시지를 helper pane 에 단순 send-keys 로 전달합니다.
# 단순화본 (이슈 #807): 이 routing 만 수행, 응답 watcher 등 우회 코드 제거.
TMUX_SESSION_NAME=helper
TMUX_TARGET_PANE=helper:0.0

# tmux 세션이 죽었을 때 bot 이 재생성하면서 띄울 명령. 절대경로 권장.
CLAUDE_BIN=claude

# dedup ledger (SQLite). 24h TTL 후 GC. 사용자 메시지 중복 처리 방지.
DEDUP_LEDGER_PATH=~/.mobruji/discord-bridge.sqlite

# --- bot.py 1초 generic auto-ack (#880) ---
# 1 (default) — 사용자 메시지 수신 즉시 짧은 generic ack 를 채널에 push.
#   helper 가 자체 ack 를 push 하기까지 bash chain latency 5+초 깜깜이 해소.
# 0 — legacy 동작 (auto-ack 없음). helper 측 ack 만 사용.
# BOT_AUTO_ACK=1

# --- digest cron ---
# 1 이면 on_ready 직후 asyncio task 가 일정 주기로 cycle-status.json 4 워크트리
# (be/fe/rev/plan) 진행/최근 한 줄씩 DIGEST_CHANNEL_ID 로 push.
DIGEST_ENABLED=1

# digest 주기 (초). 기본 300 (5분 — #1017 사용자 가시성). 양수 정수만 허용.
DIGEST_INTERVAL_SECONDS=300

# digest 가 읽는 cycle-status JSON 경로 (옵션).
# 기본 ~/.mobruji/cycle-status.json (호스트 home 자동 확장).
# mac/linux 등 호스트별 경로 분리할 때만 override.
# CYCLE_STATUS_PATH=~/.mobruji/cycle-status.json

# --- context auto-clear (spec: docs/features/context-auto-clear.md §5) ---
# 1 이면 on_ready 직후 context_auto_clear_loop 가동. opt-in (default 0).
# CONTEXT_AUTO_CLEAR_ENABLED=0

# trigger / hysteresis 임계치 (%). 기본 95 / 80.
# CONTEXT_CLEAR_TRIGGER_PCT=95
# CONTEXT_CLEAR_HYSTERESIS_PCT=80

# polling 대상 pane CSV (#855 multi-pane). 기본 nmae + helper.
# 일부 pane 의 tmux 세션 부재 시 해당 pane 만 graceful skip.
# TMUX_PANE_TARGETS=mobruji:0.0,helper:0.0

# 단일 pane 환경용 후방호환 (TMUX_PANE_TARGETS 미설정 시에만 사용).
# TMUX_PANE_TARGET=mobruji:0.0

# --- STALE_ACTIVE 검출 (#1015 follow-up, P3a remediation) ---
# 9h stale incident root cause Layer 2 fix.
# cycle_idle_watch_loop 가 기존엔 `in_progress=null + last_completed 임계 초과`
# 만 idle 로 감지했음. in_progress 가 set 됐는데 started_at 만 stale 인 케이스
# (sub-agent freeze / nmae 완료 통지 처리 누락) 는 검출 못 했음.
# 1 (default) — STALE_ACTIVE 검출 활성화. in_progress.started_at 이 임계치보다
#   오래되면 idle 와 동일 처리 (inject + Discord push + escalation 카운트 누적).
# 0 — disabled (후방호환).
# STALE_ACTIVE_ENABLED=1

# STALE_ACTIVE 임계 분 (default 60). sub-agent 평균 cycle 보다 길게 잡아
# false-positive 회피. 양수 정수만 허용.
# STALE_ACTIVE_THRESHOLD_MIN=60

# --- rev e2e 단계 2 (post-merge) 자동 trigger (#1008) ---
# spec: docs/features/rev-e2e-3-stages.md §3-2.
# 1 (default) — 5분 polling 으로 develop 머지 PR 중 rev-post-merge-pass 라벨이
#   부재한 PR 을 발굴해 nmae tmux pane 에 단계 2 audit launch 알림 inject + Discord push.
# 0 — disabled.
# REV_POST_MERGE_AUDIT_LOOP=1

# polling 주기 (초). 기본 300 (5분). 양수 정수만 허용.
# REV_POST_MERGE_AUDIT_INTERVAL_SECONDS=300

# inject 대상 tmux pane. 기본 mobruji:0.0 (nmae 본진).
# REV_POST_MERGE_AUDIT_INJECT_TARGET=mobruji:0.0

# --- directive-board auto-PATCH (#P11, 사용자 P0 사고 fix) ---
# 배경 2026-05-24: helper backfill 후 8 directive 본문이 stale (PR 머지/상태 변경
# 후에도 Discord PATCH 가 manual). 사용자 정정 — "모부르지-지시들은 그냥 계속
# 진행 중인가? 진행 상황에 변동이 없네". 자동 PATCH 파이프라인 부재가 root cause.
#
# 1 (default) — on_ready 직후 directive_board_sync_loop 가동. 5분 polling 으로
#   ~/.mobruji/directive-board.jsonl 의 last_updated_kst 비교 + 변경된 entry 만
#   Discord REST API PATCH /channels/{ch}/messages/{msg_id} 자동 호출.
# 0 — disabled (긴급 종료 등 운영자 결정 시).
DIRECTIVE_BOARD_SYNC_ENABLED=1

# polling 주기 (초). 기본 300 (5분). 양수 정수만 허용.
DIRECTIVE_BOARD_SYNC_INTERVAL=300

# directive-board Discord 채널 id. 운영 .env 에만 실값 입력 (production secret).
# 미설정 시 directive_board_sync_loop 가 skip (warning log 1회).
DIRECTIVE_BOARD_CHANNEL_ID=

# directive-board jsonl 경로 (옵션). 기본 ~/.mobruji/directive-board.jsonl.
# DIRECTIVE_BOARD_JSONL_PATH=~/.mobruji/directive-board.jsonl

# directive-board sync state 파일 경로 (옵션). atomic write + 권한 0600.
# 기본 ~/.mobruji/directive-board-sync.json.
# DIRECTIVE_BOARD_STATE_PATH=~/.mobruji/directive-board-sync.json
