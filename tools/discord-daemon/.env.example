# Discord 봇 토큰 (Developer Portal → Bot → Reset Token).
# Bot 권한: Message Content Intent 활성화 필수.
DISCORD_BOT_TOKEN=

# 명령을 받아들일 Discord user id (CSV). 정수 비교.
# 본인 user id 만 두는 것을 권장.
ALLOWED_USER_IDS=1295274270498226208

# mobruji 채널 id. 다른 채널에서 온 메시지는 모두 무시된다.
# 메인 채널 — reply / decision / alert(P1+) 카테고리 발사 대상.
MOBRUJI_CHANNEL_ID=1506925497651560458

# 알림 채널 id (옵션) — cycle-start/cycle-end/digest/alert/recovery 카테고리 발사 대상.
# 미설정 시 MOBRUJI_CHANNEL_ID 로 fallback (현재 동작). 채널 분리하려면 알림 채널 id 입력.
# spec: docs/features/discord-message-style.md §5-2.
NOTIFY_CHANNEL_ID=

# GitHub PAT. 최소 권한: `repo` (repository_dispatch 호출). classic PAT 권장.
GITHUB_PAT=

# repository_dispatch 대상 repo.
GITHUB_REPO=goohong/mobruji

# --- Phase 3 tmux bridge (옵션) ---
# 1 이면 Discord → tmux send-keys 분기, 0/미설정이면 GitHub repository_dispatch 만 수행.
TMUX_BRIDGE_ENABLED=0

# maestro tmux 세션 이름과 send-keys 타깃 pane.
TMUX_SESSION_NAME=mobruji
TMUX_TARGET_PANE=mobruji:0.0

# tmux 세션이 죽었을 때 bot 이 재생성하면서 띄울 명령. 절대경로 권장.
CLAUDE_BIN=claude

# dedup ledger (SQLite). 24h TTL 후 GC.
DEDUP_LEDGER_PATH=~/.mobruji/discord-bridge.sqlite

# pane stdout 캡처(디버깅용). 1 일 때 부팅 시 tmux pipe-pane 자동 설정.
TMUX_PIPE_PANE_ENABLED=0
TMUX_PIPE_PANE_PATH=~/.mobruji/tmux-pane.log
# 회전 임계치(바이트). 기본 100MB.
TMUX_PIPE_PANE_MAX_BYTES=104857600

# --- 5분 cron digest (옵션, ABC 가시성 패턴 C) ---
# 1 이면 on_ready 직후 asyncio task 가 5분마다 채널에 1줄 상태 push.
# "📊 PR open:N / 머지 24h:N / type:bug:N — HH:MM KST"
# 노이즈가 크면 0 으로 두고 /status 슬래시로만 운영.
DIGEST_ENABLED=1
