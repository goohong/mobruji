[Unit]
Description=mobruji agent 자동 배포 (develop 최신 동기 + agent 코드 변경 시 재시작)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root 실행 — systemctl restart mobruji-agent 권한 필요.
# git 은 스크립트 내부에서 runuser -u mobruji 로 위임 (소유권 보존).
# 스크립트는 bridge 체크아웃(자동 동기·항상 최신)의 공용 auto-deploy 를 재사용하되,
# 대상 체크아웃/서비스/감시경로는 agent 값으로 지정한다 (#1479).
ExecStart=/home/mobruji/mobruji-bridge/tools/discord-daemon/bridge-auto-deploy.sh /home/mobruji/mobruji mobruji-agent.service "^tools/agent/"
# 네트워크/gh 지연 대비 — NCP 과부하(#1453) 시에도 무한 hang 방지.
TimeoutStartSec=180
