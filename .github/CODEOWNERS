# CI/CD 워크플로우
/.github/workflows/      @goohong
/.github/CODEOWNERS      @goohong

# 라이선스
/LICENSE                 @goohong

# DB 마이그레이션
backend/**/db/migration/     @goohong
backend/**/resources/db/     @goohong

# 시크릿/환경 설정
backend/**/application*.yml         @goohong
backend/**/application*.properties  @goohong
.env*                               @goohong

# Backend 빌드 스크립트
backend/build.gradle*       @goohong
backend/settings.gradle*    @goohong
backend/gradle/             @goohong

# Web 빌드/설정
web/next.config.*           @goohong
web/package.json            @goohong
web/package-lock.json       @goohong
web/pnpm-lock.yaml          @goohong

# 인프라
Dockerfile          @goohong
docker-compose*.yml @goohong
