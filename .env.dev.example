# Phase 4 NCP dev 배포 환경 변수 — docker-compose.dev.yml 이 참조.
# docs/features/ncp-dev-deployment.md
#
# 사용:
#   cp .env.dev.example .env.dev
#   chmod 600 .env.dev
#   nano .env.dev  # 필수 값 채우기
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# .env.dev 는 .gitignore 로 보호 (실제 비밀번호/토큰 포함).

# === 필수 (?: 표기로 compose 가 부재 시 fail-fast) ===
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MOBRUJI_ADMIN_TOKEN=

# === 선택 (default 가 있음) ===
MYSQL_DATABASE=mobruji
MYSQL_USER=mobruji

# Spring profile. dev 도 application-local.yml 을 그대로 사용 (1차).
SPRING_PROFILES_ACTIVE=local

# CORS — dev origin (nginx 같은 host 라 single origin).
# ADR-0028: HTTPS 전환으로 nip.io https origin. prod 도메인 발급 시(v0.4) 교체.
MOBRUJI_CORS_ALLOWED_ORIGINS=https://101-79-20-94.nip.io

# Next.js 가 build 시점에 inline 하는 API base URL.
# nginx 가 /api/ 를 backend 로 proxy 하고, 백엔드 컨트롤러가 @RequestMapping("/api/v1/...")
# 형태로 이미 /api prefix 를 가진다. 따라서 base 는 host root (빈 문자열).
# /api 로 두면 client.ts 가 "/api" + "/api/v1/recommendations" 로 합쳐 /api/api/...
# 가 되어 backend 404 (voice-range → 추천받기 P0 버그).
# ADR-0028: HTTPS 전환으로 nip.io https origin (host root, /api suffix 없음 — 위 P0 가드 유지).
# secure context(getUserMedia 등) 활성화를 위해 https origin 으로 inline.
NEXT_PUBLIC_API_BASE_URL=https://101-79-20-94.nip.io

# 이미지 tag (CD 가 git rev-parse --short HEAD 로 채워줌).
GIT_SHA=dev

# 앨범커버 backfill(MusicBrainz/CAA) User-Agent (#1811). MusicBrainz/CAA 약관상 contact 포함
# 식별 User-Agent 의무 — 운영 이메일 contact 를 넣어 컴플라이언스 강화. 미설정 시 compose 가
# URL-only contact 기본값으로 폴백한다. 형식: <app>/<ver> (+<repo-url>; <contact-email>)
ALBUM_COVER_USER_AGENT=mobruji-backend/0.1 (+https://github.com/goohong/mobruji; you@example.com)

# === 오디오 자체분석 DooD (#1779 / #1797) — base docker-compose.dev.yml 이 항상 요구 ===
# 백엔드 컨테이너가 audio-analysis 컨테이너를 형제로 띄울 때(use-docker=true, dev 기본 활성) 필요.
# 비어 있으면 docker compose 가 fail-fast 한다. bootstrap(ncp-bootstrap-dev.sh)·cd-dev 가 자동 채움.
#
# HOST_PROJECT_DIR: 호스트의 repo 절대경로. 백엔드 컨테이너 내부 경로를 호스트 경로와
#   동일하게 미러해, 내부에서 실행한 `docker compose -f .../docker-compose.audio.yml run`
#   의 상대 bind/build 컨텍스트가 호스트 데몬 기준으로 정확히 풀리게 한다.
#   ncp-bootstrap-dev.sh 가 자동으로 채운다 (pwd 기반). 직접 채울 경우 예: /home/mobruji/mobruji
HOST_PROJECT_DIR=
# DOCKER_GID: 호스트 docker 그룹 GID. 비-root spring user(uid 1001)가 docker 소켓에
#   접근하도록 group_add 로 주입. 확인: getent group docker | cut -d: -f3
DOCKER_GID=
