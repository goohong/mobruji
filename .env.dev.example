# Phase 4 NCP dev 배포 환경 변수 — docker-compose.dev.yml 이 참조.
# docs/features/ncp-dev-deployment.md
#
# 사용:
#   cp .env.dev.example .env.dev
#   chmod 600 .env.dev
#   nano .env.dev  # 필수 값 채우기
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# .env.dev 는 .gitignore 로 보호 (실제 비밀번호/토큰 포함).

# === 필수 (?: 표기로 compose 가 부재 시 fail-fast) ===
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MOBRUJI_ADMIN_TOKEN=

# === 선택 (default 가 있음) ===
MYSQL_DATABASE=mobruji
MYSQL_USER=mobruji

# Spring profile. dev 도 application-local.yml 을 그대로 사용 (1차).
SPRING_PROFILES_ACTIVE=local

# CORS — dev origin (nginx 같은 host 라 single origin).
# ADR-0028: HTTPS 전환으로 nip.io https origin. prod 도메인 발급 시(v0.4) 교체.
MOBRUJI_CORS_ALLOWED_ORIGINS=https://101-79-20-94.nip.io

# Next.js 가 build 시점에 inline 하는 API base URL.
# nginx 가 /api/ 를 backend 로 proxy 하고, 백엔드 컨트롤러가 @RequestMapping("/api/v1/...")
# 형태로 이미 /api prefix 를 가진다. 따라서 base 는 host root (빈 문자열).
# /api 로 두면 client.ts 가 "/api" + "/api/v1/recommendations" 로 합쳐 /api/api/...
# 가 되어 backend 404 (voice-range → 추천받기 P0 버그).
# ADR-0028: HTTPS 전환으로 nip.io https origin (host root, /api suffix 없음 — 위 P0 가드 유지).
# secure context(getUserMedia 등) 활성화를 위해 https origin 으로 inline.
NEXT_PUBLIC_API_BASE_URL=https://101-79-20-94.nip.io

# 이미지 tag (CD 가 git rev-parse --short HEAD 로 채워줌).
GIT_SHA=dev
