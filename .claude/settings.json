{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "spec: docs/features/helper-tool-visibility.md (PreToolUse). PreToolUse=helper-tool-progress.sh (helper 본체만 발사 — MOBRUJI_HOOK_ACTOR=helper 가드).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.mobruji/helper-tool-progress.sh ] && $HOME/.mobruji/helper-tool-progress.sh || true"
          }
        ]
      }
    ]
  }
}
